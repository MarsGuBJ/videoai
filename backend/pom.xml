<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.9</version>
        <relativePath/>
    </parent>

    <groupId>com.videoai</groupId>
    <artifactId>monitoring-backend</artifactId>
    <version>0.1.0</version>
    <packaging>pom</packaging>
    <name>monitoring-backend</name>

    <modules>
        <module>monitoring-common</module>
        <module>monitoring-api</module>
        <module>monitoring-api-rpc</module>
        <module>monitoring-core</module>
        <module>monitoring-application</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <mybatis-plus.version>3.5.15</mybatis-plus.version>
        <spring-cloud.version>2025.0.0</spring-cloud.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.videoai</groupId>
                <artifactId>monitoring-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.videoai</groupId>
                <artifactId>monitoring-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.videoai</groupId>
                <artifactId>monitoring-api-rpc</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.videoai</groupId>
                <artifactId>monitoring-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
