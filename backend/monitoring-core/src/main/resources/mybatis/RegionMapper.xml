<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.videoai.monitoring.core.dao.RegionDao">

    <select id="selectAll" resultType="com.videoai.monitoring.core.entity.RegionEntity">
        SELECT * FROM regions
    </select>

    <select id="selectByParentAndName" resultType="com.videoai.monitoring.core.entity.RegionEntity">
        SELECT * FROM regions
        WHERE name = #{name}
        <choose>
            <when test="parentId == null">AND parent_id IS NULL</when>
            <otherwise>AND parent_id = #{parentId}</otherwise>
        </choose>
    </select>

    <select id="maxSortOrder" resultType="java.lang.Integer">
        SELECT MAX(sort_order) FROM regions
        <choose>
            <when test="parentId == null">WHERE parent_id IS NULL</when>
            <otherwise>WHERE parent_id = #{parentId}</otherwise>
        </choose>
    </select>

    <update id="updateRegion" parameterType="com.videoai.monitoring.core.entity.RegionEntity">
        UPDATE regions
        SET name = #{name},
            sort_order = #{sortOrder},
            updated_at = now()
        WHERE id = #{id}
    </update>

</mapper>
