name: "retinaface_mobilenet"
platform: "onnxruntime_onnx"
max_batch_size: 0
input [
  {
    name: "input"
    data_type: TYPE_FP32
    dims: [1, 3, 640, 640]
  }
]
output [
  { name: "loc", data_type: TYPE_FP32, dims: [-1, -1, 4] },
  { name: "cls", data_type: TYPE_FP32, dims: [-1, -1, 2] },
  { name: "land", data_type: TYPE_FP32, dims: [-1, -1, 10] }
]
instance_group [
  {
    kind: KIND_GPU
    count: 1
    gpus: [0]
  }
]
