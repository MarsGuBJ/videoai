name: "dino_coco"
backend: "onnxruntime"
max_batch_size: 0

input [
  {
    name: "image"
    data_type: TYPE_FP32
    dims: [ 1, 3, -1, -1 ]
  },
  {
    name: "im_shape"
    data_type: TYPE_FP32
    dims: [ 1, 2 ]
  },
  {
    name: "scale_factor"
    data_type: TYPE_FP32
    dims: [ 1, 2 ]
  }
]

output [
  {
    name: "save_infer_model/scale_0.tmp_0"
    data_type: TYPE_FP32
    dims: [ -1, 6 ]
  },
  {
    name: "save_infer_model/scale_1.tmp_0"
    data_type: TYPE_INT32
    dims: [ -1 ]
  }
]
