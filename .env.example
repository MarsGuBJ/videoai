POSTGRES_DB=videoai
POSTGRES_USER=videoai
POSTGRES_PASSWORD=videoai

# Windows/WSL2 usually cannot expose the built-in camera as /dev/video0.
# Use an RTSP/RTMP/HTTP camera stream for the camera source in the UI.
VIDEO_DEVICE=/dev/video0

ZLM_SECRET=035c73f7-bb6b-4889-a715-d9eb2d1925cc
ZLM_HTTP_URL=http://zlm
ZLM_PUBLIC_HTTP_URL=http://localhost:8080
ZLM_RTMP_PUSH_BASE=rtmp://localhost/live
ZLM_PREVIEW_RTMP_BASE=rtmp://127.0.0.1/live
VIDEOAI_PREVIEW_IDLE_SECONDS=10
VIDEOAI_PREVIEW_START_TIMEOUT_MS=15000
VIDEOAI_PREVIEW_FFMPEG_CMD_KEY=ffmpeg.cmd_preview_h264

TRITON_HTTP_URL=http://triton:8000
TRITON_GRPC_URL=triton:8001
TRITON_MODEL_REPOSITORY_HOST=./infra/model_repository

BACKEND_PUBLIC_URL=http://localhost:8081
BACKEND_INTERNAL_URL=http://backend:8081
# list_cameras 按需拉流代理链接（/api/live/*.flv）的对外基址，需为播放端可访问的 backend-media 地址
MEDIA_PUBLIC_URL=http://localhost:8082
PERSON_API_BASE_URL=http://10.10.3.100:15501
RETRIEVE_API_BASE_URL=http://10.10.3.100:15000
VIDEO_ANALYSIS_API_BASE_URL=http://10.10.3.100:8780
VIDEO_ANALYSIS_TIMEOUT_SECONDS=600
# mcp-server 的视频理解结构化上游服务（POST /api/v1/video-understanding/structure），按实际部署覆盖
VIDEO_UNDERSTANDING_API_BASE_URL=http://10.10.3.100:8780
VIDEO_UNDERSTANDING_TIMEOUT_SECONDS=600
# backend-lite 调 mcp-server 的地址；docker compose 部署默认走内网服务名 http://mcp-server:8097，无需设置
MCP_SERVER_BASE_URL=http://mcp-server:8097
WORKER_URL=http://worker:8090
VIDEOAI_DINO_CAMERA_HOSTS=192.168.11.65

# 算法包安装目录：backend-lite 与 worker 挂载同一目录（./storage/algorithms），
# worker 按 <code>/<version> 子路径加载算法文件
VIDEOAI_STORAGE_ALGORITHM_DIR=/data/algorithms

VIDEOAI_MCP_PLAYBACK_TTL_SECONDS=1800
HIKVISION_NVR_BASE_URL=http://192.168.1.64
HIKVISION_NVR_USERNAME=admin
HIKVISION_NVR_PASSWORD=change-me
HCNETSDK_HOST=192.168.11.198
HCNETSDK_PORT=8000
HCNETSDK_USERNAME=admin
HCNETSDK_PASSWORD=cisdi123
HCNETSDK_CHANNEL=1
# 每台设备同时保持的 SDK 回放会话上限；默认 0 不限制，demo 环境 NVR 并发受限时设为 2
HCNETSDK_MAX_LIVE_SESSIONS=0
# 录像设备（NVR 下载白名单 / CVR 集群）：置空或不设置时，mcp-server 按部署网段自动选择
# （10 网段 → NVR 10.10.7.252/253；172 网段 → CVR 172.21.200.21/22/23；新环境在
# mcp-server/app/settings.py 的 _ENV_DEVICE_DEFAULTS 追加映射），非空则按此处配置
HCNETSDK_DOWNLOAD_NVR_HOSTS=
HCNETSDK_DOWNLOAD_PORT=8000
HCNETSDK_DOWNLOAD_USERNAME=admin
HCNETSDK_DOWNLOAD_PASSWORD=
HCNETSDK_DOWNLOAD_CHANNEL=1
CVR_HOSTS=
CVR_USERNAME=admin
CVR_PASSWORD=
MINIO_ENDPOINT=192.168.11.194
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minio
MINIO_SECRET_KEY=Klg4dM9F3H
MINIO_BUCKET=public

FACE_MATCH_THRESHOLD=0.55
FACE_EVENT_COOLDOWN_SECONDS=10
FRAME_SAMPLE_FPS=2
