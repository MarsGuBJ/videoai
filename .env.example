POSTGRES_DB=videoai
POSTGRES_USER=videoai
POSTGRES_PASSWORD=videoai

# Windows/WSL2 usually cannot expose the built-in camera as /dev/video0.
# Use an RTSP/RTMP/HTTP camera stream for the camera source in the UI.
VIDEO_DEVICE=/dev/video0

ZLM_SECRET=035c73f7-bb6b-4889-a715-d9eb2d1925cc
ZLM_HTTP_URL=http://zlm
ZLM_PUBLIC_HTTP_URL=http://localhost:8080
ZLM_RTMP_PUSH_BASE=rtmp://localhost/live

TRITON_HTTP_URL=http://triton:8000
TRITON_GRPC_URL=triton:8001

BACKEND_PUBLIC_URL=http://localhost:8081
BACKEND_INTERNAL_URL=http://backend:8081
WORKER_URL=http://worker:8090

VIDEOAI_MCP_PLAYBACK_TTL_SECONDS=300
HIKVISION_NVR_BASE_URL=http://192.168.1.64
HIKVISION_NVR_USERNAME=admin
HIKVISION_NVR_PASSWORD=change-me

FACE_MATCH_THRESHOLD=0.55
FACE_EVENT_COOLDOWN_SECONDS=10
FRAME_SAMPLE_FPS=2
